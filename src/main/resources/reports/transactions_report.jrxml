<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="TransactionsReport"
              language="java"
              pageWidth="595" pageHeight="842"
              columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
    <property name="net.sf.jasperreports.compiler.xml.validation" value="false"/>

    <parameter name="status_filter" class="java.lang.String">
        <defaultValueExpression><![CDATA["All"]]></defaultValueExpression>
    </parameter>

    <queryString>
        <![CDATA[
        SELECT t.transaction_id, u.member_code, u.full_name, b.title,
               t.issue_date AS issue_date,
               t.due_date AS due_date,
               COALESCE(t.return_date, '') AS return_date,
               t.status
        FROM transactions t
        JOIN users u ON t.user_id = u.user_id
        JOIN books b ON t.book_id = b.book_id
        WHERE
            $P{status_filter} = 'All' OR t.status = $P{status_filter}
        ORDER BY t.transaction_id DESC
        ]]>
    </queryString>

    <field name="transaction_id" class="java.lang.Integer"/>
    <field name="member_code" class="java.lang.String"/>
    <field name="full_name" class="java.lang.String"/>
    <field name="title" class="java.lang.String"/>
    <field name="issue_date" class="java.lang.String"/>
    <field name="due_date" class="java.lang.String"/>
    <field name="return_date" class="java.lang.String"/>
    <field name="status" class="java.lang.String"/>

    <background>
        <band height="0" splitType="Stretch"/>
    </background>

    <title>
        <band height="90" splitType="Stretch">
            <rectangle>
                <reportElement mode="Opaque" x="0" y="0" width="555" height="70" backcolor="#86000D"/>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="20" y="10" width="320" height="30" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle"><font size="20" isBold="true"/></textElement>
                <text><![CDATA[LAPORAN TRANSAKSI SIRKULASI]]></text>
            </staticText>
            <staticText>
                <reportElement x="20" y="40" width="320" height="20" forecolor="#ECEEF0"/>
                <textElement verticalAlignment="Top"><font size="10" isItalic="true"/></textElement>
                <text><![CDATA[Sistem Informasi Perpustakaan Freedom]]></text>
            </staticText>
            <textField>
                <reportElement x="380" y="40" width="155" height="20" forecolor="#ECEEF0"/>
                <textElement textAlignment="Right" verticalAlignment="Top"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="350" y="15" width="185" height="20" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Status Transaksi: " + ($P{status_filter}.equals("All") ? "Semua" : ($P{status_filter}.equals("Issued") ? "Dipinjam" : ($P{status_filter}.equals("Returned") ? "Dikembalikan" : "Hilang")))]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="30" splitType="Stretch">
            <line>
                <reportElement positionType="FixRelativeToBottom" x="0" y="25" width="555" height="1" forecolor="#86000D"/>
                <graphicElement><pen lineWidth="1.5"/></graphicElement>
            </line>
            <staticText>
                <reportElement x="0" y="0" width="45" height="20"/>
                <textElement verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[ID Trans]]></text>
            </staticText>
            <staticText>
                <reportElement x="45" y="0" width="65" height="20"/>
                <textElement verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[Kode Anggota]]></text>
            </staticText>
            <staticText>
                <reportElement x="110" y="0" width="100" height="20"/>
                <textElement verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[Nama Anggota]]></text>
            </staticText>
            <staticText>
                <reportElement x="210" y="0" width="130" height="20"/>
                <textElement verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[Judul Buku]]></text>
            </staticText>
            <staticText>
                <reportElement x="340" y="0" width="65" height="20"/>
                <textElement verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[Tgl Pinjam]]></text>
            </staticText>
            <staticText>
                <reportElement x="405" y="0" width="65" height="20"/>
                <textElement verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[Tenggat]]></text>
            </staticText>
            <staticText>
                <reportElement x="470" y="0" width="55" height="20"/>
                <textElement verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[Kembali]]></text>
            </staticText>
            <staticText>
                <reportElement x="525" y="0" width="30" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[Stts]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="25" splitType="Stretch">
            <textField>
                <reportElement x="0" y="2" width="45" height="20"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA["#" + $F{transaction_id}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="45" y="2" width="65" height="20"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{member_code} == null ? "" : $F{member_code}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement x="110" y="2" width="100" height="20"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{full_name}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement x="210" y="2" width="130" height="20"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{title}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="340" y="2" width="65" height="20"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{issue_date} == null ? "-" : $F{issue_date}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="405" y="2" width="65" height="20"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{due_date} == null ? "-" : $F{due_date}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="470" y="2" width="55" height="20"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{return_date} == null || $F{return_date}.isEmpty() ? "-" : $F{return_date}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="525" y="2" width="30" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{status}.equals("Issued") ? "Aktif" : ($F{status}.equals("Returned") ? "Selesai" : "Hilang")]]></textFieldExpression>
            </textField>
            <line>
                <reportElement positionType="FixRelativeToBottom" x="0" y="24" width="555" height="1" forecolor="#ECEEF0"/>
            </line>
        </band>
    </detail>

    <pageFooter>
        <band height="30" splitType="Stretch">
            <textField>
                <reportElement x="435" y="5" width="80" height="20"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["Halaman "+$V{PAGE_NUMBER}+" dari"]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="515" y="5" width="40" height="20"/>
                <textFieldExpression><![CDATA[" " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="5" width="150" height="20" forecolor="#5C5F61"/>
                <textElement><font size="8"/></textElement>
                <text><![CDATA[Perpustakaan Freedom - Laporan Sistem]]></text>
            </staticText>
        </band>
    </pageFooter>
</jasperReport>
