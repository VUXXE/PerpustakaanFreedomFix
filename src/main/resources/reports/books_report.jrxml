<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="BooksReport"
              language="java"
              pageWidth="595" pageHeight="842"
              columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
    <property name="net.sf.jasperreports.compiler.xml.validation" value="false"/>
    <parameter name="logoPath" class="java.lang.String"/>


    <parameter name="status_filter" class="java.lang.String">
        <defaultValueExpression><![CDATA["All"]]></defaultValueExpression>
    </parameter>

    <queryString>
        <![CDATA[
        SELECT book_id, isbn, title, author, publisher, total_copies, available_copies
        FROM books
        WHERE
            $P{status_filter} = 'All'
            OR ($P{status_filter} = 'Available' AND available_copies > 0)
            OR ($P{status_filter} = 'OutOfStock' AND available_copies = 0)
        ORDER BY book_id
        ]]>
    </queryString>

    <field name="book_id" class="java.lang.Integer"/>
    <field name="isbn" class="java.lang.String"/>
    <field name="title" class="java.lang.String"/>
    <field name="author" class="java.lang.String"/>
    <field name="publisher" class="java.lang.String"/>
    <field name="total_copies" class="java.lang.Integer"/>
    <field name="available_copies" class="java.lang.Integer"/>

    <background>
        <band height="0" splitType="Stretch"/>
    </background>

    <title>
        <band height="90" splitType="Stretch">
            <rectangle>
                <reportElement mode="Opaque" x="0" y="0" width="555" height="70" backcolor="#86000D"/>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </rectangle>
            <image scaleImage="RetainShape" hAlign="Center" vAlign="Middle">
                <reportElement x="15" y="10" width="50" height="50" />
                <imageExpression><![CDATA[$P{logoPath}]]></imageExpression>
            </image>
            <staticText>
                <reportElement x="75" y="10" width="320" height="30" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle"><font size="20" isBold="true"/></textElement>
                <text><![CDATA[LAPORAN DATA KOLEKSI BUKU]]></text>
            </staticText>
            <staticText>
                <reportElement x="75" y="40" width="320" height="20" forecolor="#ECEEF0"/>
                <textElement verticalAlignment="Top"><font size="10" isItalic="true"/></textElement>
                <text><![CDATA[Sistem Informasi Perpustakaan Freedom]]></text>
            </staticText>
            <textField>
                <reportElement x="380" y="40" width="155" height="20" forecolor="#ECEEF0"/>
                <textElement textAlignment="Right" verticalAlignment="Top"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="380" y="15" width="155" height="20" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Filter Stok: " + ($P{status_filter}.equals("All") ? "Semua" : ($P{status_filter}.equals("Available") ? "Tersedia" : "Habis"))]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="30" splitType="Stretch">
            <line>
                <reportElement positionType="FixRelativeToBottom" x="0" y="25" width="555" height="1" forecolor="#86000D"/>
                <graphicElement><pen lineWidth="1.5"/></graphicElement>
            </line>
            <staticText>
                <reportElement x="0" y="0" width="35" height="20"/>
                <textElement verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[ID]]></text>
            </staticText>
            <staticText>
                <reportElement x="35" y="0" width="95" height="20"/>
                <textElement verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[ISBN]]></text>
            </staticText>
            <staticText>
                <reportElement x="130" y="0" width="180" height="20"/>
                <textElement verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[Judul Buku]]></text>
            </staticText>
            <staticText>
                <reportElement x="310" y="0" width="105" height="20"/>
                <textElement verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[Penulis]]></text>
            </staticText>
            <staticText>
                <reportElement x="415" y="0" width="80" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[Penerbit]]></text>
            </staticText>
            <staticText>
                <reportElement x="495" y="0" width="30" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[Tot]]></text>
            </staticText>
            <staticText>
                <reportElement x="525" y="0" width="30" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[Avail]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="25" splitType="Stretch">
            <textField>
                <reportElement x="0" y="2" width="35" height="20"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{book_id}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="35" y="2" width="95" height="20"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{isbn} == null || $F{isbn}.isEmpty() ? "-" : $F{isbn}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement x="130" y="2" width="180" height="20"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{title}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement x="310" y="2" width="105" height="20"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{author} == null || $F{author}.isEmpty() ? "-" : $F{author}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement x="415" y="2" width="80" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{publisher} == null || $F{publisher}.isEmpty() ? "-" : $F{publisher}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="495" y="2" width="30" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{total_copies}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="525" y="2" width="30" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{available_copies}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement positionType="FixRelativeToBottom" x="0" y="24" width="555" height="1" forecolor="#ECEEF0"/>
            </line>
        </band>
    </detail>

    <pageFooter>
        <band height="30" splitType="Stretch">
            <textField>
                <reportElement x="435" y="5" width="80" height="20"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["Halaman "+$V{PAGE_NUMBER}+" dari"]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="515" y="5" width="40" height="20"/>
                <textFieldExpression><![CDATA[" " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="5" width="150" height="20" forecolor="#5C5F61"/>
                <textElement><font size="8"/></textElement>
                <text><![CDATA[Perpustakaan Freedom - Laporan Sistem]]></text>
            </staticText>
        </band>
    </pageFooter>
</jasperReport>
